import sympy
from sympy import *

"""
We are working with the variable x
"""
x = symbols('x')

def formula(guess, function, derivative):
    return (guess - function.subs(x, guess) / derivative.subs(x, guess)).evalf()

"""
Take the function, and the necessary information
We are going to approximate its zero using Newton's method
"""
myFunction = sympify(input("Please enter the function: "))
myGuess = sympify(input("Please enter a guess: "))
myDerivative = diff(myFunction, x)

"""
Make the variable before doing the calculations
decimals and myNextDecimals are the exact same code, but they are not the same value ws
They are executed at different times between updating myNextGuess
"""
myNextGuess = formula(myGuess, myFunction, myDerivative)
myNextGuess_1 = formula(myNextGuess, myFunction, myDerivative)
sympy.pprint(myNextGuess)
sympy.pprint(myNextGuess_1)

"""
We will make the computer do Newton's method over and over again
We will stop once the the first 6 decimal places of 2 consecutive guesses match up
"""
agree = False
while not agree:
    myNextGuess_1 = formula(myNextGuess_1, myFunction, myDerivative)
    decimals_1 = str(myNextGuess_1).split('.')[1]
    sympy.pprint(str(myNextGuess_1).split('.')[0] + '.' + str(myNextGuess_1).split('.')[1][:6])

    myNextGuess_2 = formula(myNextGuess_1, myFunction, myDerivative)
    decimals_2 = str(myNextGuess_2).split('.')[1]

    if decimals_1[:6] == decimals_2[:6]:
        agree = True