class skytrainLine:
    def __init__ (self, lineName):
        self.getLineName = lineName
        self.getListOfStations = []
    
    def addStation (self, stationName):
        self.getListOfStations.append(stationName)

    def getStationList(self):
        return self.getListOfStations

    def lineName (self):
        return self.getLineName

    def printNames (self):
        for i in range (len(self.getListOfStations)):
            print("|"+self.getListOfStations[i]+".", end = "")

def checkAndIdentifyLine (name):
    global lines
    statuses = []
    myLines = ""

    for i in range (len(lines)):
        if (((name + "\n") in lines[i].getStationList()) or 
        ((name + " *(ME)\n") in lines[i].getStationList()) or
        ((name + " *(EC)\n") in lines[i].getStationList()) or 
        ((name + " *(C)\n") in lines[i].getStationList())):
            statuses.append(True)
            myLines += lines[i].lineName() + ", "
        
        else:
            statuses.append(False)
    
    if True in statuses:
        return myLines 

    else: 
        return "Please ensure that station names are entered properly"
    
def countInstances (myString, character):
    counter = 0

    for i in range (len(myString)):
        if myString[i] == str(character):
            counter += 1

    return counter 

def routeOnSameLine(firstStation, secondStation):
    global lines
    residingLine = ""
    
    if "Millenium Line" in checkAndIdentifyLine(firstStation.replace("*", "")) and "Expo Line" in checkAndIdentifyLine(firstStation.replace("*", "")):
        if "Millenium Line" in checkAndIdentifyLine(secondStation.replace("*", "")) and "Expo Line" in checkAndIdentifyLine(secondStation.replace("*", "")):
            print("Transfer to the Millenium Line")
            currentLinePos1 = milleniumLine.getStationList().index(firstStation.replace("*", " *(ME)\n"))
            currentLinePos2 = milleniumLine.getStationList().index(secondStation.replace("*", " *(ME)\n"))
            print("Ride " + str(abs(currentLinePos2 - currentLinePos1)) + " stop(s) to " + secondStation.replace("*", ""))

    if countInstances(checkAndIdentifyLine(secondStation.replace("*", "")), ",") == 2:
        residingLine = checkAndIdentifyLine(firstStation).replace(",", "")
    
    else:
        residingLine = checkAndIdentifyLine(secondStation).replace(", ", "")
    
    for i in range (len(lines)):
        if lines[i].lineName() == residingLine and ("*" not in firstStation) and ("*" not in secondStation):
            currentLine = lines[i]
            currentLinePos1 = currentLine.getStationList().index(firstStation + "\n")
            currentLinePos2 = currentLine.getStationList().index(secondStation + "\n")
            print("Ride " + str(abs(currentLinePos2 - currentLinePos1)) + " stop(s) to " + secondStation)
        
        elif lines[i].lineName() == residingLine and ("*" in firstStation) and ("*" not in secondStation):
            firstStation = firstStation.replace("*", " *(ME)\n")
            for j in range (len(lines)):
                if lines[j].lineName() == residingLine:
                    currentLine = lines[j]
                    currentLinePos1 = currentLine.getStationList().index(firstStation)
                    currentLinePos2 = currentLine.getStationList().index(secondStation + "\n")
                    print("Ride " + str(abs(currentLinePos2 - currentLinePos1)) + " stop(s) to " + secondStation)
        
        elif lines[i].lineName() == residingLine and ("*" in secondStation) and ("*" not in firstStation):
            secondStation = secondStation.replace("*", "* (ME)\n")
            for j in range (len(lines)):
                if lines[j].lineName() == residingLine:
                    currentLine = lines[j]
                    currentLinePos1 = currentLine.getStationList().index(firstStation + "\n")
                    currentLinePos2 = currentLine.getStationList().index(secondStation)
                    print("Ride " + str(abs(currentLinePos2 - currentLinePos1)) + " stops to " + secondStation)

def routeToSameLine (initialStation, finalLineName, finalStation):
    global lines

    initialLineName = checkAndIdentifyLine(initialStation)
    initialLineName = initialLineName[:-2]
    criticalPoints = []
    for i in range (len(lines)):
        if lines[i].lineName() == initialLineName:
            initialLineStations = lines[i].getStationList()
            for j in range (len(initialLineStations)):
                if "*" in initialLineStations[j]:
                    criticalPoints.append(initialLineStations[j])

    codes = []
    for i in range (len(criticalPoints)):
        initialBracketIndex = criticalPoints[i].index("(")
        finalBracketIndex = criticalPoints[i].index(")")
        codes.append(criticalPoints[i][(initialBracketIndex + 1) : finalBracketIndex])
    
    finalLineName = finalLineName[:-2]
    
    if initialLineName == "Millenium Line" and finalLineName == "Expo Line":

        distances = [milleniumLine.getStationList().index(initialStation + "\n") - milleniumLine.getStationList().index("Commercial Broadway *(ME)\n"),
                      milleniumLine.getStationList().index(initialStation + "\n") - milleniumLine.getStationList().index("Production Way University *(ME)\n"),
                        milleniumLine.getStationList().index(initialStation + "\n") - milleniumLine.getStationList().index("Lougheed Town Centre *(ME)\n")]
    
        absoluteDistances = []
        for i in range (len(distances)):
            absoluteDistances.append(abs(distances[i]))

        shortestAbsoluteDistance = min(absoluteDistances)
        shortestDistanceIndex = absoluteDistances.index(shortestAbsoluteDistance)
        shortestDistance = distances[shortestDistanceIndex]
        nextStationName = ""
        if shortestDistance > 0:
            nextStationName = milleniumLine.getStationList()[milleniumLine.getStationList().index(initialStation + "\n") - shortestDistance]
        
        else:
            nextStationName = milleniumLine.getStationList()[milleniumLine.getStationList().index(initialStation + "\n") + abs(shortestDistance)]
        
        print("Ride " + str(shortestAbsoluteDistance) + " stop(s) to " + nextStationName.replace(" *(ME)", ""), end = "")
        print("Transfer to the " + finalLineName)
        routeOnSameLine(nextStationName.replace(" *(ME)\n", "*"), finalStation)

